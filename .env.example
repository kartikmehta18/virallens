# ─── Mode ───────────────────────────────────────────────────────────────
# TEST_MODE=on  → no passwords: anyone "logs in" with an id kept in the browser's localStorage.
# TEST_MODE=off → real email/password accounts stored in the database.
TEST_MODE=on

# Secret used to sign session cookies (required when TEST_MODE=off in production).
AUTH_SECRET=

# ─── Database (optional, MySQL / MariaDB) ───────────────────────────────
# If these are empty the app runs on an in-memory store (data resets on restart).
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Alternatively: DATABASE_URL="mysql://user:password@host:3306/dbname"
# Optional: an empty second database used only by `npm run db:migrate` (prisma migrate dev) to create new migrations
SHADOW_DATABASE_URL=

# ─── Cache (optional) ───────────────────────────────────────────────────
# Redis for scrape-result caching + rate limiting. Falls back to in-memory.
REDIS_URL=

# ─── Apify (optional) ───────────────────────────────────────────────────
# Without a token the app generates realistic demo data so everything still works.
APIFY_API_TOKEN=
APIFY_ACTOR_X=apidojo/tweet-scraper
APIFY_ACTOR_LINKEDIN=harvestapi/linkedin-post-search
APIFY_ACTOR_INSTAGRAM=apify/instagram-hashtag-scraper
# Actors used to fetch a favorite creator's own posts (Creators page)
APIFY_ACTOR_X_PROFILE=apidojo/tweet-scraper
APIFY_ACTOR_LINKEDIN_PROFILE=harvestapi/linkedin-profile-posts
APIFY_ACTOR_INSTAGRAM_PROFILE=apify/instagram-scraper
# Max items requested per platform per scrape
APIFY_MAX_ITEMS=40
# Optional JSON input overrides per actor. Placeholders: {{topic}} {{hashtag}} {{limit}}
# APIFY_INPUT_X={"searchTerms":["{{topic}}"],"maxItems":"{{limit}}","sort":"Top"}
# Creator actors use {{handle}} {{profileUrl}} {{limit}}:
# APIFY_INPUT_LINKEDIN_PROFILE={"targetUrls":["{{profileUrl}}"],"maxPosts":"{{limit}}"}
# How long (seconds) a topic scrape is considered fresh
SCRAPE_CACHE_TTL=21600
# Scrapes allowed per user/IP per hour
SCRAPE_RATE_LIMIT=20

# ─── AI breakdown (optional) ────────────────────────────────────────────
# Set any one (or several). They are tried in order Claude → OpenAI → Gemini; if every call fails or no key
# is set, a built-in heuristic analysis is used. Gemini has a free tier: https://aistudio.google.com/apikey
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
# OPENAI_MODEL=gpt-4o-mini
# GEMINI_MODEL=gemini-flash-latest

# ─── Alerts (optional) ──────────────────────────────────────────────────
RESEND_API_KEY=
ALERT_FROM_EMAIL=ViralLens <alerts@example.com>
APP_URL=http://localhost:3000
# Protects /api/cron/* (Vercel Cron sends it as a Bearer token)
CRON_SECRET=
